# TaxBriefing 백엔드 환경변수
# 비밀키는 이 파일에 넣지 말고 Secret Manager 또는 로컬 .env 에만 둔다 (§12.1).

TAXBRIEFING_ENVIRONMENT=local
TAXBRIEFING_DEBUG=true

# docker-compose 의 db 서비스는 호스트 5433 포트로 노출된다.
TAXBRIEFING_DATABASE_URL=postgresql+psycopg://taxbriefing:taxbriefing@localhost:5433/taxbriefing

# 운영에서는 반드시 교체한다. local/test 외 환경에서 기본값이면 기동이 거부된다.
TAXBRIEFING_JWT_SECRET=dev-only-insecure-secret-change-me
TAXBRIEFING_ACCESS_TOKEN_TTL_MINUTES=60

# AI 제공자 (§9.5). 계정 확보 전까지는 stub 으로 파이프라인 전체를 개발한다 (미결 ⑨).
TAXBRIEFING_AI_PROVIDER=stub
TAXBRIEFING_AI_MODEL=stub-analysis-v1
TAXBRIEFING_AI_PROMPT_VERSION=1.0.0
# TAXBRIEFING_AI_API_KEY=

# 국가법령정보 공동활용 OPEN API (부록 A).
# OC 는 open.law.go.kr 에서 신청할 때 직접 지정하는 식별자다. 호출 URL의 ?OC= 값.
# 프론트엔드에 노출하지 않는다 — 호출 한도가 이 값에 묶인다.
# TAXBRIEFING_LAW_API_OC=

# 발송 채널 (§11.4). 이메일 공급자는 미결 ①.
# 텔레그램은 명세서 v1.0 이후 추가된 내부 운영용 채널이다.
# TAXBRIEFING_TELEGRAM_BOT_TOKEN=
# TAXBRIEFING_TELEGRAM_CHAT_ID=

# 테스트용 DB. 설정하지 않으면 통합 테스트는 skip 된다.
TAXBRIEFING_TEST_DATABASE_URL=postgresql+psycopg://taxbriefing:taxbriefing@localhost:5433/taxbriefing_test
